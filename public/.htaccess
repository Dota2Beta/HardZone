RewriteEngine On

# Примеры реальных редиректов
RewriteRule ^old-catalog/?$ catalog.php [R=301,L]
RewriteRule ^promo/?$ index.php [R=302,L]

# Корректный кастомный 404 для проекта в подпапке:
# если запрошенный файл/папка не существует, показываем errors/404.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ errors/404.php [L]
